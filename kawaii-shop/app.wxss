page {
  --pink: #FF9AAF;
  --green: #7ED4A6;
  --orange: #FFB87A;
  --blue: #C7CEEA;
  --yellow: #FFF5BA;
  --bg-color: #FFF9F0;
  --text-primary: #5A4A42;
  --text-secondary: #8B7B72;
  --border-radius: 24rpx;

  background-color: var(--bg-color);
  font-family: "PingFang SC", "Microsoft YaHei", "STYuanti-SC-Regular", sans-serif;
  color: var(--text-primary);
}

/* 全局按钮点击效果 */
.btn-hover {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 全局动画 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
