/* 页面容器 */
.order-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 180rpx;
}

/* Header */
.header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 40rpx 40rpx;
  background: linear-gradient(135deg, var(--pink) 0%, var(--orange) 100%);
  border-radius: 0 0 50rpx 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 175, 0.3);
}

.page-title {
  font-size: 52rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
}

.mascot {
  font-size: 80rpx;
  animation: float 3s ease-in-out infinite;
}

.version-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* Tab容器 */
.tab-container {
  display: flex;
  padding: 20rpx 40rpx;
  background: white;
  margin: 0 40rpx 20rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  margin: 0 10rpx;
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, var(--pink) 0%, #FFC8D6 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 154, 175, 0.3);
}

.tab-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.tab-name {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.tab-item.active .tab-name {
  color: white;
  font-weight: bold;
}

/* 菜品列表 */
.dish-list {
  padding: 20rpx 40rpx;
  height: calc(100vh - 400rpx);
  box-sizing: border-box;
}

/* 菜品卡片 */
.dish-card {
  display: flex;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: white;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 175, 0.15);
  border: 2rpx solid rgba(255, 154, 175, 0.1);
}

.dish-image-wrapper {
  position: relative;
  margin-right: 24rpx;
}

.dish-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFF9F0 100%);
}

.dish-image-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFF9F0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.dish-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.dish-category-tag {
  padding: 6rpx 16rpx;
  background: var(--green);
  color: white;
  font-size: 20rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

.dish-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.dish-actions {
  display: flex;
  gap: 16rpx;
}

.add-cart-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--pink) 0%, #FFC8D6 100%);
  transition: all 0.2s ease;
}

.btn-hover {
  transform: scale(0.95);
}

.add-icon {
  font-size: 36rpx;
  color: white;
  margin-right: 8rpx;
  font-weight: bold;
}

.add-text {
  font-size: 26rpx;
  color: white;
  font-weight: bold;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ========== 底部悬浮马卡龙小卡片 ========== */
.cart-float-card {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: 40rpx;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
  background: linear-gradient(135deg, #FFC8D6 0%, #FFB5E8 50%, #C7CEEA 100%);
  border-radius: 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 154, 175, 0.45);
  animation: slideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.card-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-basket-icon {
  font-size: 44rpx;
}

.card-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.card-arrow {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  animation: arrowBounce 1.5s ease-in-out infinite;
}

@keyframes arrowBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* ========== 底部滑出弹窗 ========== */
.popup-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0);
  z-index: 1000;
  transition: background 0.35s ease;
}
.popup-mask--visible {
  background: rgba(0,0,0,0.45);
}

.popup-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  background: #FFF9F0;
  border-radius: 40rpx 40rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 -10rpx 40rpx rgba(255,154,175,0.25);
}
.popup-sheet--visible {
  transform: translateY(0);
}

/* 拖拽把手 */
.popup-handle-bar {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}
.popup-handle {
  width: 72rpx;
  height: 10rpx;
  background: rgba(139,123,114,0.25);
  border-radius: 5rpx;
}

/* 弹窗头部 */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx 28rpx;
  border-bottom: 2rpx solid rgba(255,154,175,0.2);
}
.popup-title {
  font-size: 38rpx;
  font-weight: bold;
  color: var(--text-primary);
}
.popup-close-btn {
  width: 56rpx;
  height: 56rpx;
  background: #FFE5EC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.popup-close-icon {
  font-size: 36rpx;
  color: #FF9AAF;
  font-weight: bold;
}

/* 弹窗主体 */
.popup-body {
  flex: 1;
  padding: 28rpx 32rpx;
  overflow-y: auto;
  max-height: 55vh;
}

/* ========== 购物车菜品项 + 折叠菜谱 ========== */
.cart-dish-item {
  margin-bottom: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(255,154,175,0.12);
  border: 2rpx solid rgba(255,154,175,0.15);
}

.cart-dish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.cart-dish-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cart-dish-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.cart-dish-category-tag {
  padding: 4rpx 14rpx;
  background: var(--green);
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.cart-dish-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cart-qty-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #FFF5F5;
  border-radius: 20rpx;
  padding: 4rpx 8rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}
.qty-btn--minus {
  background: #FFE5EC;
  color: #FF9AAF;
}
.qty-btn--plus {
  background: #D4F5E2;
  color: #7ED4A6;
}
.qty-num {
  min-width: 36rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.expand-arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: transform 0.3s ease;
  margin-left: 4rpx;
}
.expand-arrow--up {
  transform: rotate(180deg);
}

/* ========== 折叠菜谱面板 ========== */
.recipe-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  background: #FFF5F8;
}
.recipe-panel--open {
  max-height: 600rpx;
}

.recipe-panel-inner {
  padding: 24rpx 28rpx 32rpx;
  border-top: 2rpx dashed rgba(255,154,175,0.3);
}

.recipe-section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #FF9AAF;
  margin-bottom: 16rpx;
}

.recipe-empty {
  padding: 16rpx 0;
}
.recipe-empty-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-style: italic;
}

.recipe-steps {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recipe-step-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 0;
}

.step-dot {
  font-size: 16rpx;
  color: #FFB87A;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 25rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

/* 空状态 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 40rpx;
  gap: 12rpx;
}
.empty-cart-icon {
  font-size: 90rpx;
  animation: float 3s ease-in-out infinite;
}
.empty-cart-text {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}
.empty-cart-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* ========== 弹窗底部操作栏 ========== */
.popup-footer {
  padding: 24rpx 36rpx 40rpx;
  border-top: 2rpx solid rgba(255,154,175,0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
}

.footer-info {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.footer-total-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.footer-total-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF9AAF;
}

.footer-confirm-btn {
  padding: 22rpx 56rpx;
  background: linear-gradient(135deg, #FF9AAF 0%, #FFB87A 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(255,154,175,0.4);
  transition: all 0.2s ease;
}

/* ========== 动画 ========== */
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-10rpx); }
}

@keyframes bounce-in {
  0%  { transform: scale(0); opacity: 0; }
  50% { transform: scale(1.1); }
  100%{ transform: scale(1); opacity: 1; }
}

@keyframes badge-pop {
  0%  { transform: scale(0); }
  50% { transform: scale(1.3); }
  100%{ transform: scale(1); }
}
