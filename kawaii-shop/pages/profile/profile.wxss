/* 页面容器 */
.profile-page {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 100rpx;
}

/* Header */
.header {
  padding: 60rpx 40rpx 40rpx;
  background: linear-gradient(135deg, var(--orange) 0%, var(--yellow) 100%);
  border-radius: 0 0 50rpx 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 122, 0.3);
  text-align: center;
}

.page-title {
  font-size: 48rpx;
  font-weight: bold;
  color: white;
}

/* 星星罐子 */
.star-jar-container {
  display: flex;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.star-jar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
  background: white;
  border-radius: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 184, 122, 0.2);
  border: 3rpx solid var(--orange);
}

.jar-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  animation: float 3s ease-in-out infinite;
}

.star-count {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.star-count.animate .star-number {
  animation: star-bounce 0.6s ease;
}

/* 星星加减按钮 */
.star-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  font-size: 36rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.star-btn-minus {
  background: rgba(255, 154, 175, 0.2);
  color: #FF9AAF;
}

.star-btn-plus {
  background: rgba(255, 183, 77, 0.2);
  color: #FFB74D;
}

.star-number {
  display: block;
  font-size: 96rpx;
  font-weight: bold;
  color: var(--orange);
  line-height: 1;
}

.star-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* 成就头衔 */
.title-card {
  display: flex;
  align-items: center;
  padding: 40rpx;
  margin: 0 40rpx 30rpx;
  background: white;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 122, 0.15);
}

.title-icon {
  font-size: 80rpx;
  margin-right: 30rpx;
  animation: star-twinkle 2s ease-in-out infinite;
}

.title-info {
  flex: 1;
}

.title-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.title-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 成就进度 */
.achievement-progress {
  padding: 40rpx;
  margin: 0 40rpx 30rpx;
  background: white;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 122, 0.15);
}

.progress-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.progress-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.progress-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-color);
  border-radius: 20rpx;
  opacity: 0.5;
}

.progress-item.completed {
  opacity: 1;
  background: linear-gradient(135deg, #FFF9F0 0%, #FFF5E6 100%);
  border: 2rpx solid var(--orange);
}

.progress-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.progress-info {
  flex: 1;
}

.progress-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.progress-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.progress-check {
  font-size: 40rpx;
  color: var(--orange);
  font-weight: bold;
}

/* 烹饪记录 */
.cook-history {
  padding: 40rpx;
  margin: 0 40rpx;
  background: white;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 122, 0.15);
}

.history-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--bg-color);
  border-radius: 20rpx;
}

.history-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.history-info {
  flex: 1;
}

.history-dish {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.history-time {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.history-stars {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--orange);
}

.empty-history {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 动画 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

@keyframes star-bounce {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

@keyframes star-twinkle {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.8; transform: scale(1.1); }
}
